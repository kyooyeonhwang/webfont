---
export interface Props {
  heading: string;
  lead: string;
  fonts: { fontName: string; className: string }[];
}

const { heading, lead, fonts } = Astro.props
---
<div class="content">
  <div class="header-wrap">
    <hgroup>
      <h2>{heading}</h2>
      <p>{lead}</p>
    </hgroup>
    <textarea cols="30" rows="10" class="font-editor" id="jsFontEditor" aria-label="미리보기 텍스트 입력">1234567890
가나다라마바사
ABCDEFGHIJKLNMOPQRSTUVWXYZ
abcdefghijklnmopqrstuvwxyz</textarea>
  </div>

  <ul class="font-preview-container" id="jsFontPreview">
    {
      fonts.map((data) => (
        <li class="list-item">
          <p class="font-name">{data.fontName}</p>
          <div class:list={[ 'font-preview', 'ui-font-preview', data.className ]}></div>
        </li>
      ))
    }
  </ul>
</div>
