---
const navItems = [
  { href: '/font-list/', label: '한글 일반 폰트' },
  { href: '/preview/', label: '한글 가변 폰트' },
  { href: '/font-compare/', label: '폰트 비교' }
]

const normalize = (path: string) => path.replace(/\/$/, '')
const currentPath = normalize(Astro.url.pathname)
---
<header class="header">
  <h1><a href="/">font preview</a></h1>
  <ul class="nav">
    {
      navItems.map((item) => (
        <li>
          <a href={item.href} aria-current={normalize(item.href) === currentPath ? 'page' : undefined}>{item.label}</a>
        </li>
      ))
    }
  </ul>
</header>
