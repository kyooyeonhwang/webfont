---
import Layout from '../layouts/Layout.astro'
import FontPreviewSection from '../components/FontPreviewSection.astro'

const fontPreviewLists = [
  {
    fontName: 'Pretendard Variable',
    className: 'pretendard'
  },
  {
    fontName: 'Pretendard',
    className: 'pretendard-normal'
  }
]
---
<Layout
  title="| 일반 폰트와 가변 폰트 비교"
  description={`프리텐다드 일반 폰트와 가변 폰트(Variable Font)를 나란히 비교하며 렌더링 차이와 사용성을 확인해볼 수 있습니다.`}>
    <FontPreviewSection
      heading="폰트 비교"
      lead="일반폰트와 가변 폰트를 비교하기 위해서 입니다."
      fonts={fontPreviewLists}
    />
</Layout>
