---
import Layout from '../layouts/Layout.astro'
import FontPreviewSection from '../components/FontPreviewSection.astro'
import FontFilter from '../components/FontFilter.astro'

const fontPreviewLists = [
  {
    fontName: 'Pretendard Variable',
    className: 'pretendard'
  },
  {
    fontName: 'SUIT Variable',
    className: 'suit'
  },
  {
    fontName: 'SUITE Variable',
    className: 'suite'
  },
  {
    fontName: 'Min Sans Variable',
    className: 'minsans'
  },
  {
    fontName: 'Noto Sans KR Variable',
    className: 'notosans'
  },
  {
    fontName: 'Nanum Square Neo Variable',
    className: 'nanum-square-neo'
  },
  {
    fontName: 'Wanted Sans Variable',
    className: 'wantedsans'
  },
  {
    fontName: 'Freesentation Variable',
    className: 'freesentation'
  },
  {
    fontName: 'AstaSans Variable',
    className: 'astasans'
  }
]
---
<Layout
  title="| 한글 가변 폰트 미리보기"
  description={`프리텐다드, 수트, 민 산스 등 가변 폰트(Variable Font)를 지원하는 한글 웹폰트를 실시간으로 미리보기하세요. 폰트 굵기와 크기를 자유롭게 조절하며 비교할 수 있습니다.`}>
    <FontPreviewSection
      heading="한글 가변 폰트"
      lead="본문에 사용할만한 가변 폰트 목록입니다."
      fonts={fontPreviewLists}
    />
    <FontFilter fonts={fontPreviewLists} />
</Layout>
