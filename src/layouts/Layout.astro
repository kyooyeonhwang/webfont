---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import MainHead from '../components/MainHead.astro'
import FontStyleCustom from '../components/FontStyleCustom.astro'
import '../../public/css/styles.scss';

export interface Props {
  title: string;
  description: string;
  isHome?: boolean;
  disableWeight?: boolean;
}

const { title, description, isHome = false, disableWeight = false } = Astro.props;
---
<html lang="ko">
  <head>
    <MainHead title={title} description={description} />
  </head>
  <body class:list={[{ home: isHome }]}>
      <Header/>
      <main>
        {!isHome && <FontStyleCustom disableWeight={disableWeight} />}
        <slot />
      </main>
      <Footer />
  {!isHome && <script is:inline src="/js/app.js"></script>}
  </body>
</html>
